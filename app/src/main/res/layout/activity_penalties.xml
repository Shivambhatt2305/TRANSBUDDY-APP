<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_penalties.xml
    Penalties & Fines Screen — Android conversion of the HTML Penalties page.

    Layout:
    DrawerLayout
      ├── ConstraintLayout (main)
      │   ├── AppBarLayout  (Toolbar)
      │   ├── NestedScrollView
      │   │   └── LinearLayout (vertical, padding 16dp)
      │   │       ├── Page Header  ("Penalties & Fines" + subtitle)
      │   │       ├── Search Bar   (neo-inset pill)
      │   │       ├── Stats Row    (2 CardViews: Active Penalties | Total Fines)
      │   │       ├── Assign Penalty Card
      │   │       │   ├── Header (gavel icon + title)
      │   │       │   ├── Driver/Vehicle spinner
      │   │       │   ├── Infraction Type spinner
      │   │       │   ├── Fine Amount input
      │   │       │   ├── Notes textarea
      │   │       │   └── Issue Penalty button
      │   │       ├── Recent Actions header
      │   │       └── RecyclerView (penalty list)
      │   └── BottomNavigationView
      └── NavigationView (drawer)
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/penaltiesDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- ═══════════════════════════════════════════════════════
         MAIN CONTENT
    ═══════════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ─────────────────────────────────────────────────
             TOP APP BAR
        ───────────────────────────────────────────────── -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/penaltiesAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:elevation="6dp"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/penaltiesToolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/surface"
                android:paddingStart="4dp"
                android:paddingEnd="12dp">

                <ImageButton
                    android:id="@+id/penaltiesBtnMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Open menu"
                    android:src="@drawable/ic_menu_hamburger"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Transbuddy"
                    android:textColor="@color/primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- ─────────────────────────────────────────────────
             SCROLLABLE CANVAS
        ───────────────────────────────────────────────── -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/penaltiesAppBar"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:paddingBottom="8dp">

                <!-- ═══════════════════════════════════════════
                     PAGE HEADER
                ═══════════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Penalties &amp; Fines"
                    android:textColor="@color/on_surface"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage disciplinary actions and logistical infractions."
                    android:textColor="@color/on_surface_variant"
                    android:textSize="13sp"
                    android:layout_marginBottom="20dp" />

                <!-- ═══════════════════════════════════════════
                     SEARCH BAR
                     Matches: neo-inset rounded-xl
                ═══════════════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_search_bar"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="24dp"
                    android:elevation="2dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_search"
                        android:layout_marginEnd="10dp"
                        app:tint="@color/on_surface_variant" />

                    <EditText
                        android:id="@+id/etPenaltySearch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Search drivers, vehicles, or IDs..."
                        android:textColorHint="@color/on_surface_variant"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp"
                        android:inputType="text"
                        android:imeOptions="actionSearch"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- ═══════════════════════════════════════════
                     STATS ROW
                     Matches: grid grid-cols-2 — two neo-raised stat cards
                ═══════════════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <!-- Stat 1: Active Penalties -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/tvActivePenaltiesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12"
                                android:textColor="@color/error"
                                android:textSize="36sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="6dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Active Penalties\nThis Week"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp"
                                android:gravity="center"
                                android:lineSpacingExtra="2dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Stat 2: Total Fines -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/tvTotalFines"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$850"
                                android:textColor="@color/primary"
                                android:textSize="36sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="6dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Fines\nIssued"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp"
                                android:gravity="center"
                                android:lineSpacingExtra="2dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- ═══════════════════════════════════════════
                     ASSIGN PENALTY CARD
                     Matches: neo-raised rounded-2xl p-6 (left column)
                ═══════════════════════════════════════════ -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Card Header: gavel icon circle + title -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="20dp">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_neo_inset_circle"
                                android:layout_marginEnd="12dp"
                                android:elevation="1dp">
                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@android:drawable/ic_menu_agenda"
                                    app:tint="@color/error" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Assign Penalty"
                                android:textColor="@color/on_surface"
                                android:textSize="17sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- ── Driver / Vehicle Spinner ── -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Driver / Vehicle"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp"
                            android:layout_marginStart="4dp" />

                        <Spinner
                            android:id="@+id/spinnerDriver"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_search_bar"
                            android:padding="14dp"
                            android:layout_marginBottom="16dp" />

                        <!-- ── Infraction Type Spinner ── -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Infraction Type"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp"
                            android:layout_marginStart="4dp" />

                        <Spinner
                            android:id="@+id/spinnerInfraction"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_search_bar"
                            android:padding="14dp"
                            android:layout_marginBottom="16dp" />

                        <!-- ── Fine Amount Input ── -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fine Amount (USD)"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp"
                            android:layout_marginStart="4dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_search_bar"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="14dp"
                            android:layout_marginBottom="16dp"
                            android:elevation="2dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />

                            <EditText
                                android:id="@+id/etFineAmount"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@null"
                                android:hint="0.00"
                                android:textColorHint="@color/on_surface_variant"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:inputType="numberDecimal"
                                android:singleLine="true" />
                        </LinearLayout>

                        <!-- ── Notes Textarea ── -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Additional Notes"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp"
                            android:layout_marginStart="4dp" />

                        <EditText
                            android:id="@+id/etPenaltyNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_search_bar"
                            android:padding="16dp"
                            android:hint="Provide context..."
                            android:textColorHint="@color/on_surface_variant"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:maxLines="5"
                            android:gravity="top|start"
                            android:layout_marginBottom="20dp"
                            android:scrollbars="vertical" />

                        <!-- ── Issue Penalty Button ── -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnIssuePenalty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="6dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:paddingVertical="16dp"
                                android:paddingHorizontal="24dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@android:drawable/ic_input_add"
                                    android:layout_marginEnd="8dp"
                                    app:tint="@color/error" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Issue Penalty"
                                    android:textColor="@color/error"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ═══════════════════════════════════════════
                     RECENT DISCIPLINARY ACTIONS CARD
                ═══════════════════════════════════════════ -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recent Disciplinary Actions"
                            android:textColor="@color/on_surface"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewPenalties"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════════════════════════════════════════════════════
         NAVIGATION DRAWER  (Penalties item checked)
    ═══════════════════════════════════════════════════════ -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/penaltiesNavigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        android:elevation="16dp"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/nav_drawer_color"
        app:itemTextColor="@color/nav_drawer_color"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
