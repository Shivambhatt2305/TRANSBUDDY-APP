<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_face_recognition_penalty.xml
    Face Recognition Camera Scanner & Live Database Penalty Management Screen
    Standard DrawerLayout + Hamburger Menu (3 lines) UI
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/faceDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:elevation="6dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarFacePenalty"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/surface"
                android:paddingStart="4dp"
                android:paddingEnd="12dp">

                <ImageButton
                    android:id="@+id/faceBtnMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Open menu"
                    android:src="@drawable/ic_menu_hamburger"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Transbuddy"
                    android:textColor="@color/primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/screen_padding_horizontal"
                    android:paddingEnd="@dimen/screen_padding_horizontal"
                    android:paddingTop="@dimen/screen_padding_vertical"
                    android:paddingBottom="@dimen/screen_bottom_padding"
                    app:layout_constraintWidth_max="@dimen/content_max_width"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                <!-- ═══════════════════════════════════════════
                     1. CAMERA SCAN & PHOTO CAPTURE CARD
                ═══════════════════════════════════════════ -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/surface_container">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rider Face Scanner"
                            android:textColor="@color/on_surface"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Click a live photo or upload image to identify rider from DB and issue penalty."
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="12dp" />

                        <!-- Bus Selection Dropdown Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Select Bus Fleet / Route"
                                android:textColor="@color/on_surface"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_input_box"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingEnd="8dp">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_transport_bus"
                                    app:tint="@color/primary" />

                                <Spinner
                                    android:id="@+id/spinnerBusSelection"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@null"
                                    android:spinnerMode="dropdown" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Captured Photo Preview Container -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/camera_preview_height"
                            android:background="@drawable/bg_input_box"
                            android:layout_marginBottom="12dp">

                            <ImageView
                                android:id="@+id/ivFacePreview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@android:drawable/ic_menu_camera"
                                app:tint="@color/on_surface_variant" />

                            <!-- Scanning overlay animation / progress indicator -->
                            <LinearLayout
                                android:id="@+id/layoutScanningProgress"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#99000000"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <ProgressBar
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:indeterminateTint="@color/primary" />

                                <TextView
                                    android:id="@+id/tvScanningStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="Scanning Face with AI Model..."
                                    android:textColor="@android:color/white"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </FrameLayout>

                        <!-- Camera and Gallery Action Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCapturePhoto"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:text="CLICK PHOTO"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:cornerRadius="10dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPickGallery"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:text="GALLERY"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:cornerRadius="10dp" />
                        </LinearLayout>

                        <!-- Match Status Chip -->
                        <TextView
                            android:id="@+id/tvMatchStatusChip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_demo_chip"
                            android:padding="8dp"
                            android:text="Ready to scan face..."
                            android:textAlignment="center"
                            android:textColor="@color/on_surface"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ═══════════════════════════════════════════
                     2. RECOGNIZED RIDER DETAILS CARD
                ═══════════════════════════════════════════ -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRiderProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Profile Header (Avatar + Name + Status) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <ImageView
                                android:id="@+id/ivRiderAvatar"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:background="@drawable/bg_input_box"
                                android:scaleType="centerCrop"
                                android:src="@android:drawable/ic_menu_myplaces"
                                app:tint="@color/primary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvRiderName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Select / Scan Rider"
                                    android:textColor="@color/on_surface"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvRiderIdChip"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ID: --"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvRiderMemberType"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="STUDENT PROFILE"
                                    android:textColor="@color/primary"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvTransportStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#D1FAE5"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text="Paid"
                                android:textColor="#065F46"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/surface_container_high"
                            android:layout_marginBottom="12dp" />

                        <!-- Clean Vertical Key-Value Details (No squishing) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Department / Sem"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvDeptSem"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ICT-DEGREE (Sem 8, Morning)"
                                android:textColor="@color/on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Assigned Bus &amp; Route"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvBusRoute"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TB-102 (Route 9)"
                                android:textColor="@color/on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pickup Point"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvPickupPoint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Central Station, Gate 2"
                                android:textColor="@color/on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Registered Email"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvRiderEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="student@marwadi.edu"
                                android:textColor="@color/on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ═══════════════════════════════════════════
                     3. PREVIOUS PENALTY HISTORY
                ═══════════════════════════════════════════ -->
                <TextView
                    android:id="@+id/tvPenaltyHistoryHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Previous Penalties (0 Active)"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPreviousPenalties"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginBottom="16dp" />

                <!-- ═══════════════════════════════════════════
                     4. ISSUE PENALTY FORM
                ═══════════════════════════════════════════ -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡ Issue New Disciplinary Fine"
                            android:textColor="@color/on_surface"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACID-guaranteed database transaction &amp; instant official notification dispatch."
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="12dp" />

                        <!-- Infraction Category Spinner -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Infraction Category"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <Spinner
                            android:id="@+id/spinnerInfraction"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_input_box"
                            android:layout_marginBottom="12dp" />

                        <!-- Fine Amount Input -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fine Amount (₹)"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/etFineAmount"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_input_box"
                            android:hint="500"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="12dp"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp"
                            android:layout_marginBottom="12dp" />

                        <!-- Officer Remarks / Notes -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Violation Remarks / Notes"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/etPenaltyNotes"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:background="@drawable/bg_input_box"
                            android:gravity="top|start"
                            android:hint="e.g. Scanned on campus bus TB-102 without valid transit pass"
                            android:inputType="textMultiLine"
                            android:padding="12dp"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:layout_marginBottom="16dp" />

                        <!-- Submit Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnIssuePenalty"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="⚡ ISSUE PENALTY &amp; SEND NOTICE"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Navigation Drawer View -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/faceNavigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        android:elevation="16dp"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/nav_drawer_color"
        app:itemTextColor="@color/nav_drawer_color"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
