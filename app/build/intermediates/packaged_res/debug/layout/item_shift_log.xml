<?xml version="1.0" encoding="utf-8"?>
<!--
    item_shift_log.xml
    Single row in the Recent Logs list.
    Matches HTML: neo-pressed rounded-lg p-4 flex items-center justify-between
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_neo_inset"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- Icon circle (neo-raised small) -->
    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_neo_raised_circle"
        android:elevation="3dp"
        android:layout_marginEnd="12dp">

        <ImageView
            android:id="@+id/ivShiftLogIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_menu_upload"
            app:tint="@color/on_surface_variant" />
    </FrameLayout>

    <!-- Title + subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvShiftLogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shift Started"
            android:textColor="@color/on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvShiftLogSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terminal A"
            android:textColor="@color/on_surface_variant"
            android:textSize="11sp"
            android:layout_marginTop="1dp" />
    </LinearLayout>

    <!-- Timestamp -->
    <TextView
        android:id="@+id/tvShiftLogTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Yesterday"
        android:textColor="@color/on_surface_variant"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
