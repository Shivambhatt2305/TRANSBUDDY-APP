<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fuelDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ── Top Toolbar ── -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/fuelAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:elevation="0dp"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/fuelToolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/surface"
                android:paddingStart="4dp"
                android:paddingEnd="12dp">

                <ImageButton
                    android:id="@+id/fuelBtnMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Open menu"
                    android:src="@drawable/ic_menu_hamburger"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Transbuddy"
                    android:textColor="@color/primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- ── Main Content Scroll Area ── -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/fuelAppBar"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/screen_padding_horizontal"
                    android:paddingEnd="@dimen/screen_padding_horizontal"
                    android:paddingTop="@dimen/screen_padding_vertical"
                    android:paddingBottom="@dimen/screen_bottom_padding"
                    app:layout_constraintWidth_max="@dimen/content_max_width"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                <!-- Page Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fuel &amp; Odometer Logs"
                    android:textColor="@color/on_surface"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Record vehicle refuel details and current odometer reading."
                    android:textColor="@color/on_surface_variant"
                    android:textSize="13sp"
                    android:layout_marginBottom="20dp" />

                <!-- ═══════════════════════════════════════════
                     MAIN LOG ENTRY FORM (Unified Structured Card)
                ═══════════════════════════════════════════ -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Section Header 1: Refuel Details -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Refuel Information"
                            android:textColor="@color/primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp" />

                        <!-- Station Name -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Station Name / Location"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp" />

                        <EditText
                            android:id="@+id/etStation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/bg_search_bar"
                            android:hint="e.g. Shell Station, Highway 1"
                            android:textColorHint="@color/on_surface_variant"
                            android:inputType="text"
                            android:padding="14dp"
                            android:singleLine="true"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp" />

                        <!-- Fuel Type Dropdown -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fuel Type"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp" />

                        <Spinner
                            android:id="@+id/spinnerFuelType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_search_bar"
                            android:padding="14dp"
                            android:spinnerMode="dropdown"
                            android:popupBackground="@color/surface"
                            android:layout_marginBottom="16dp" />

                        <!-- Liters + Price per Unit (2-column side-by-side grid) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Fuel Volume (L / KG)"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="12sp"
                                    android:layout_marginBottom="6dp" />

                                <EditText
                                    android:id="@+id/etLiters"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_search_bar"
                                    android:padding="14dp"
                                    android:hint="0.00"
                                    android:textColorHint="@color/on_surface_variant"
                                    android:textColor="@color/on_surface"
                                    android:textSize="14sp"
                                    android:inputType="numberDecimal"
                                    android:singleLine="true" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Fuel Price (₹ / Unit)"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="12sp"
                                    android:layout_marginBottom="6dp" />

                                <EditText
                                    android:id="@+id/etFuelPrice"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_search_bar"
                                    android:padding="14dp"
                                    android:hint="e.g. 94.20"
                                    android:textColorHint="@color/on_surface_variant"
                                    android:textColor="@color/on_surface"
                                    android:textSize="14sp"
                                    android:inputType="numberDecimal"
                                    android:singleLine="true" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Total Cost (₹) -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Cost (₹ INR)"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp" />

                        <EditText
                            android:id="@+id/etCost"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_search_bar"
                            android:padding="14dp"
                            android:hint="0.00"
                            android:textColorHint="@color/on_surface_variant"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp"
                            android:inputType="numberDecimal"
                            android:singleLine="true"
                            android:layout_marginBottom="20dp" />

                        <!-- Section Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/outline"
                            android:alpha="0.2"
                            android:layout_marginBottom="20dp" />

                        <!-- Section Header 2: Odometer Reading -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Odometer Reading"
                            android:textColor="@color/primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp" />

                        <!-- ONLY Single Current KM Reading Field (As requested by user) -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Current Odometer Reading (KM)"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp" />

                        <EditText
                            android:id="@+id/etCurrentKm"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_search_bar"
                            android:padding="14dp"
                            android:hint="e.g. 142580"
                            android:textColorHint="@color/on_surface_variant"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp"
                            android:inputType="number"
                            android:singleLine="true"
                            android:layout_marginBottom="20dp" />

                        <!-- Section Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/outline"
                            android:alpha="0.2"
                            android:layout_marginBottom="20dp" />

                        <!-- Section Header 3: Receipt Attachment -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Receipt Attachment"
                            android:textColor="@color/primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnScanReceipt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            android:layout_marginBottom="24dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_search_bar"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:padding="14dp">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@android:drawable/ic_menu_camera"
                                    android:layout_marginEnd="8dp"
                                    app:tint="@color/primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tap to attach receipt photo"
                                    android:textColor="@color/primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Receipt Photo Preview (Shown once captured) -->
                        <LinearLayout
                            android:id="@+id/layoutReceiptPreview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="24dp"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/ivReceiptThumbnail"
                                android:layout_width="match_parent"
                                android:layout_height="180dp"
                                android:scaleType="centerCrop"
                                android:background="@drawable/bg_search_bar" />

                            <TextView
                                android:id="@+id/btnRemoveReceipt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✕ Remove Receipt Photo"
                                android:textColor="@color/error"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_gravity="end"
                                android:layout_marginTop="6dp"
                                android:padding="4dp" />
                        </LinearLayout>

                        <!-- Save Log Action Button -->
                        <LinearLayout
                            android:id="@+id/btnSaveLog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_btn_primary_simple"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:paddingVertical="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Save Log Entry"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ═══════════════════════════════════════════
                     RECENT ENTRIES SECTION
                ═══════════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recent Log Entries"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewFuelLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── Navigation Drawer ── -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/fuelNavigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        android:elevation="16dp"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/nav_drawer_color"
        app:itemTextColor="@color/nav_drawer_color"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
