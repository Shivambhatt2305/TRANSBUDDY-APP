<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_fuel_logs.xml
    Fuel & KM Logs Screen - Android conversion of the HTML Fuel Log page.

    Layout:
    DrawerLayout
      ├── ConstraintLayout
      │   ├── AppBarLayout (Toolbar)
      │   ├── NestedScrollView
      │   │   └── LinearLayout (vertical)
      │   │       ├── Page Title + Subtitle
      │   │       ├── Fuel Details Card
      │   │       │   ├── Station input
      │   │       │   ├── Liters + Cost inputs (2-column grid)
      │   │       │   └── Receipt scan button
      │   │       ├── Odometer Card
      │   │       │   ├── Start KM input
      │   │       │   └── End KM input
      │   │       ├── Save Log Entry button
      │   │       ├── Recent Entries header
      │   │       └── RecyclerView (fuel log list)
      │   └── BottomNavigationView
      └── NavigationView (drawer)
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fuelDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- ═══════════════════════════════════════════════════════
         MAIN CONTENT
    ═══════════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ─────────────────────────────────────────────────
             TOP APP BAR
        ───────────────────────────────────────────────── -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/fuelAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:elevation="6dp"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/fuelToolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/surface"
                android:paddingStart="4dp"
                android:paddingEnd="12dp">

                <ImageButton
                    android:id="@+id/fuelBtnMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Open menu"
                    android:src="@drawable/ic_menu_hamburger"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Transbuddy"
                    android:textColor="@color/primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- ─────────────────────────────────────────────────
             SCROLLABLE CANVAS
        ───────────────────────────────────────────────── -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/fuelAppBar"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:paddingBottom="8dp">

                <!-- ═══════════════════════════════════════════
                     PAGE HEADER
                     Matches: h1 "Log Entry" + subtitle
                ═══════════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Log Entry"
                    android:textColor="@color/on_surface"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Record your latest fuel fill-up and odometer readings."
                    android:textColor="@color/on_surface_variant"
                    android:textSize="14sp"
                    android:layout_marginBottom="24dp"
                    android:lineSpacingExtra="2dp" />

                <!-- ═══════════════════════════════════════════
                     FUEL DETAILS CARD
                     Matches: neo-surface rounded-2xl p-6 shadow-neo-raised
                ═══════════════════════════════════════════ -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Card Header: icon + title -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="20dp">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@android:drawable/ic_menu_recent_history"
                                android:layout_marginEnd="10dp"
                                app:tint="@color/primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fuel Details"
                                android:textColor="@color/primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Station Name input -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Station Name / Location"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp"
                            android:layout_marginStart="4dp" />

                        <EditText
                            android:id="@+id/etStation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/bg_search_bar"
                            android:hint="e.g. Shell Highway 1"
                            android:textColorHint="@color/on_surface_variant"
                            android:inputType="text"
                            android:padding="16dp"
                            android:singleLine="true"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp" />

                        <!-- Liters + Cost (2-col grid) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">

                            <!-- Liters column -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Liters (L)"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="12sp"
                                    android:layout_marginBottom="6dp"
                                    android:layout_marginStart="4dp" />

                                <EditText
                                    android:id="@+id/etLiters"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_search_bar"
                                    android:padding="16dp"
                                    android:hint="0.00"
                                    android:textColorHint="@color/on_surface_variant"
                                    android:textColor="@color/on_surface"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:inputType="numberDecimal"
                                    android:singleLine="true" />
                            </LinearLayout>

                            <!-- Cost column -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total Cost ($)"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="12sp"
                                    android:layout_marginBottom="6dp"
                                    android:layout_marginStart="4dp" />

                                <EditText
                                    android:id="@+id/etCost"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_search_bar"
                                    android:padding="16dp"
                                    android:hint="0.00"
                                    android:textColorHint="@color/on_surface_variant"
                                    android:textColor="@color/on_surface"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:inputType="numberDecimal"
                                    android:singleLine="true" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Receipt Scan Button -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Receipt Image"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp"
                            android:layout_marginStart="4dp" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnScanReceipt"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@android:drawable/ic_menu_camera"
                                    android:layout_marginBottom="4dp"
                                    app:tint="@color/primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tap to scan receipt"
                                    android:textColor="@color/primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ═══════════════════════════════════════════
                     ODOMETER CARD
                     Matches: "Odometer Reading" card with speed icon, tertiary color
                ═══════════════════════════════════════════ -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Card Header: speed icon + title (tertiary color) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="20dp">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@android:drawable/ic_menu_compass"
                                android:layout_marginEnd="10dp"
                                app:tint="@color/tertiary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Odometer Reading"
                                android:textColor="@color/tertiary"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Start KM + End KM (2-col grid) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Start KM -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Start KM"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="12sp"
                                    android:layout_marginBottom="6dp"
                                    android:layout_marginStart="4dp" />

                                <EditText
                                    android:id="@+id/etStartKm"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_search_bar"
                                    android:padding="16dp"
                                    android:text="142500"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:inputType="number"
                                    android:singleLine="true" />
                            </LinearLayout>

                            <!-- End KM -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="End KM"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="12sp"
                                    android:layout_marginBottom="6dp"
                                    android:layout_marginStart="4dp" />

                                <EditText
                                    android:id="@+id/etEndKm"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_search_bar"
                                    android:padding="16dp"
                                    android:hint="Enter current KM"
                                    android:textColorHint="@color/on_surface_variant"
                                    android:textColor="@color/on_surface"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:inputType="number"
                                    android:singleLine="true" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ═══════════════════════════════════════════
                     SAVE LOG ENTRY BUTTON
                     Matches: neo-raised full-width button
                ═══════════════════════════════════════════ -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnSaveLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="28dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingVertical="18dp"
                        android:paddingHorizontal="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Save Log Entry"
                            android:textColor="@color/primary"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@android:drawable/ic_menu_save"
                            app:tint="@color/primary" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ═══════════════════════════════════════════
                     RECENT ENTRIES HEADER
                ═══════════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recent Entries"
                    android:textColor="@color/on_surface"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="2dp"
                    android:layout_marginBottom="12dp" />

                <!-- ═══════════════════════════════════════════
                     FUEL LOG RECYCLER VIEW
                ═══════════════════════════════════════════ -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewFuelLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════════════════════════════════════════════════════
         NAVIGATION DRAWER
    ═══════════════════════════════════════════════════════ -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/fuelNavigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        android:elevation="16dp"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/nav_drawer_color"
        app:itemTextColor="@color/nav_drawer_color"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
