<?xml version="1.0" encoding="utf-8"?>
<!-- Alert banner with left red border effect -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Left border layer -->
    <item android:left="0dp" android:right="4dp" android:top="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/error" />
            <corners android:topLeftRadius="16dp" android:bottomLeftRadius="16dp" />
        </shape>
    </item>
    <!-- White fill layer offset by 4dp to create left border -->
    <item android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:topRightRadius="16dp" android:bottomRightRadius="16dp" />
        </shape>
    </item>
</layer-list>
